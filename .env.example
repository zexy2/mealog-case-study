# ---- Vision provider (only needed for `make eval-live` / real API runs) ----
# The default `make eval` runs fully offline against recorded fixtures.
VISION_PROVIDER=fixture           # fixture | gemini
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey

# ---- Database ----
DATABASE_URL=postgresql://mealog:mealog@localhost:5432/mealog

# ---- Runtime ----
LOG_LEVEL=INFO
DEFAULT_LOCALE=en_US
